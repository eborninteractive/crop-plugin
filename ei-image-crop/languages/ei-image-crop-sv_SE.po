msgid "Adjust crop"
msgstr "Justera beskärning"

msgid "All"
msgstr "Alla"

msgid "Cancel"
msgstr "Avbryt"

msgid "Close"
msgstr "Stäng"

msgid "Could not delete that crop."
msgstr "Kunde inte radera den beskärningen."

msgid "Could not find the original image file."
msgstr "Kunde inte hitta originalbildfilen."

msgid "Could not read the original image dimensions."
msgstr "Kunde inte läsa originalbildens dimensioner."

msgid "Could not read the source image."
msgstr "Kunde inte läsa källbilden."

msgid "Crop image"
msgstr "Beskär bild"

msgid "Crops"
msgstr "Beskärningar"

msgid "Delete"
msgstr "Radera"

msgid "Delete image"
msgstr "Radera bild"

msgid "Delete image?"
msgstr "Radera bild?"

msgid "Edit image details (caption, alt text, etc.)"
msgstr "Redigera bilddetaljer (bildtext, alt-text, m.m.)"

msgid "Ei Image Crop requires Advanced Custom Fields (or ACF PRO) to be installed and active."
msgstr "Ei Image Crop kräver att Advanced Custom Fields (eller ACF PRO) är installerat och aktiverat."

msgid "Existing crops"
msgstr "Befintliga beskärningar"

msgid "Image Crop"
msgstr "Bildbeskärning"

msgid "Image ID"
msgstr "Bild-ID"

msgid "Image URL"
msgstr "Bild-URL"

msgid "Image array"
msgstr "Bilddata (array)"

msgid "Image size"
msgstr "Bildformat"

msgid "Invalid source image."
msgstr "Ogiltig källbild."

msgid "Keep in mind that the image is permanently deleted, and if this exact crop is used anywhere else on the site, it will need to be replaced."
msgstr "Tänk på att bilden försvinner permanent och om du använder just denna beskärning av bilden någon annanstans på hemsidan måste den ersättas."

msgid "Library"
msgstr "Bibliotek"

msgid "One of the image sizes registered on this site (Settings > Media, or added by a theme/plugin via add_image_size()). A size registered without hard cropping is treated as a free-form crop."
msgstr "Ett av de bildformat som är registrerade på sajten (Inställningar > Media, eller tillagda av ett tema/plugin via add_image_size()). Ett format som registrerats utan hård beskärning behandlas som fri beskärning."

msgid "Original images"
msgstr "Originalbilder"

msgid "Please select an image."
msgstr "Välj en bild."

msgid "Preview"
msgstr "Förhandsvisning"

msgid "%d saved"
msgstr "%d sparade"

msgid "Remove image"
msgstr "Ta bort bild"

msgid "Return format"
msgstr "Returformat"

msgid "Select an image"
msgstr "Välj en bild"

msgid "Select image"
msgstr "Välj bild"

msgid "Something went wrong while cropping the image."
msgstr "Något gick fel vid beskärning av bilden."

msgid "Source is not a valid image attachment."
msgstr "Källan är inte en giltig bifogad bildfil."

msgid "That is not a crop this plugin can delete."
msgstr "Det är inte en beskärning som det här tillägget kan radera."

msgid "Uploaded to post"
msgstr "Uppladdad till inlägget"

msgid "Use image"
msgstr "Använd bild"

msgid "Use this image"
msgstr "Använd denna bild"

msgid "You are not allowed to do this."
msgstr "Du har inte behörighet att göra detta."

msgid "free crop"
msgstr "fri beskärning"

